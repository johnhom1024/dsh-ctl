#!/bin/bash
# dsh-ctl — Mac 本机 dsh web 的统一控制面（launchd 之上的薄封装）
#
# 进程模型：dsh web 由 LaunchAgent（LABEL）持有（PPID=1，归 launchd），
# 任何 agent / 终端 / GUI 退出都带不走它。本脚本是唯一推荐的控制入口。
#
# 常用命令：
#   dsh-ctl status     状态（launchd job + 端口 + 版本）
#   dsh-ctl url        打印当前带 token 的访问 URL（浏览器/宿主直连用）
#   dsh-ctl open       用默认浏览器打开 token URL
#   dsh-ctl log        tail -f dsh web 日志
#   dsh-ctl start      启动（bootstrap LaunchAgent）
#   dsh-ctl stop       真停（bootout，不会被拉回）
#   dsh-ctl restart    重启（kickstart -k）
#   dsh-ctl adopt      把当前宿主拉起的 3080 切换到 launchd 接管（一次性迁移）
#   dsh-ctl install    写入/修复 LaunchAgent plist（幂等）
#   dsh-ctl port [N]   查看端口；port N 改端口（重写 plist + 重启生效）
#   dsh-ctl channel    查看/切换发布通道（latest / next / 具体版本号）
#   dsh-ctl doctor     环境自检（node/包管理器/plist/launchd/端口/token）

set -euo pipefail

LABEL="cn.${USER}.dsh-web"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG="$HOME/Library/Logs/dsh-web.log"
# 端口真相源是 plist（可能被手动改过，如 3080→3082），环境变量可覆盖，兜底 3080
PORT="${DSH_CTL_PORT:-$(grep -A1 -m1 -- '--port</string>' "$PLIST" 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)}"
: "${PORT:=3080}"
DOMAIN="gui/$(id -u)"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# doctor：逐项体检，OK/WARN/FAIL 一目了然；返回码 0=全绿 1=有 FAIL
cmd_doctor() {
  local fail=0
  echo "== dsh-ctl doctor =="

  if command -v node >/dev/null 2>&1; then
    echo "[OK]   node $(node --version) ($(command -v node))"
  else
    echo "[FAIL] node 未安装"; fail=1
  fi

  if detect_pm; then
    echo "[OK]   包管理器: ${PM_BIN} ${PM_ARGS[*]}"
  else
    echo "[FAIL] 未找到 pnpm / yarn 2+ / npx"; fail=1
  fi

  if [ -f "$PLIST" ]; then
    if plutil -lint "$PLIST" >/dev/null 2>&1; then
      echo "[OK]   plist 合法 ${PLIST}"
    else
      echo "[FAIL] plist 损坏: $PLIST"; fail=1
    fi
  else
    echo "[WARN] plist 不存在（还没 dsh-ctl install？）"
  fi

  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    echo "[OK]   launchd job 已加载"
  else
    echo "[WARN] launchd job 未加载（还没 dsh-ctl start？）"
  fi

  if pid=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) && [ -n "$pid" ]; then
    local p="$pid" ok=0
    for _ in 1 2 3 4 5; do
      p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
      [ -z "$p" ] && break
      [ "$p" = "1" ] && { ok=1; break; }
    done
    if [ "$ok" = "1" ]; then
      echo "[OK]   端口 $PORT 监听中，归属 launchd"
    else
      echo "[WARN] 端口 $PORT 监听中但非 launchd 归属（考虑 dsh-ctl adopt）"
    fi
  else
    echo "[WARN] 端口 $PORT 无监听（服务没起来？dsh-ctl status 看详情）"
  fi

  if [ -n "$(token_url)" ]; then
    echo "[OK]   token URL 可从日志解析"
  else
    echo "[WARN] 日志里没有 token URL（服务没起来或日志被清）"
  fi

  if [ "$fail" = "1" ]; then echo "结论: 有 FAIL 项，先修上面的 [FAIL]"; exit 1; fi
  echo "结论: 基础环境正常"
}

# 包管理器探测：pnpm > yarn(2+) > npx。launchd 不走 shell，必须解析成绝对路径。
PM_BIN="" PM_ARGS=()
detect_pm() {
  local bin
  if bin="$(command -v pnpm 2>/dev/null)"; then
    PM_BIN="$bin"; PM_ARGS=(--config.dangerouslyAllowAllBuilds=true dlx); return 0
  fi
  if bin="$(command -v yarn 2>/dev/null)" && ! yarn --version 2>/dev/null | grep -q '^1\.'; then
    PM_BIN="$bin"; PM_ARGS=(dlx); return 0
  fi
  if bin="$(command -v npx 2>/dev/null)"; then
    PM_BIN="$bin"; PM_ARGS=(-y); return 0
  fi
  return 1
}

need_job() {
  if ! launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    echo "LaunchAgent $LABEL 未加载。先执行: dsh-ctl install && dsh-ctl start" >&2
    exit 1
  fi
}

cmd_status() {
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    echo "== launchd job: $LABEL =="
    launchctl print "$DOMAIN/$LABEL" | grep -E '^\s+(state|pid|runs|last exit)' || true
  else
    echo "== launchd job: $LABEL 未加载 =="
  fi
  echo "== 端口 ${PORT}（通道 $(current_channel || echo latest)）=="
  if pid=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) && [ -n "$pid" ]; then
    ps -o pid,ppid,lstart,command -p "$pid" | cut -c1-160
    # pnpm dlx 模式下监听进程是 launchd 的孙进程，需沿父链向上找
    local chain="$pid" p="$pid" ok=0
    for _ in 1 2 3 4 5; do
      p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
      [ -z "$p" ] && break
      [ "$p" = "1" ] && { ok=1; break; }
      chain+=" → $p"
    done
    if [ "$ok" = "1" ]; then
      echo "  归属: launchd（正确，进程链 ${chain}）"
    else
      echo "  归属: 非 launchd（链 ${chain}），异常，考虑 dsh-ctl adopt"
    fi
  else
    echo "  无进程监听"
  fi
  # dsh web 日志不打版本号；版本藏在监听进程的 dlx 缓存路径里
  local v=""
  if [ -n "${pid:-}" ]; then
    v=$(ps -o command= -p "$pid" 2>/dev/null | grep -oE '@deepseek-ai\+dsh@[0-9][0-9a-zA-Z.+-]+' | head -1 | sed 's/.*@//') || v=""
  fi
  if [ -f "$LOG" ] && [ -z "$v" ]; then
    v=$(grep -oE 'dsh web [0-9][^ ]*|@deepseek-ai/dsh@[0-9][^ ]*' "$LOG" | tail -1) || v=""
  fi
  echo "== 版本 == ${v:-未见（服务未运行）}"
}

token_url() {
  grep -oE "http://127\.0\.0\.1:${PORT}/\?token=[^ \"']+" "$LOG" 2>/dev/null | tail -1
}

cmd_url() {
  local u; u="$(token_url)"
  if [ -z "$u" ]; then
    echo "日志里没有 token URL（服务未启动或日志轮换）。dsh-ctl status 检查。" >&2
    exit 1
  fi
  echo "$u"
}

cmd_open() { open "$(cmd_url)"; }

cmd_log() { touch "$LOG"; exec tail -f "$LOG"; }

cmd_start() {
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    echo "已在加载，kickstart"; launchctl kickstart "$DOMAIN/$LABEL"
  else
    [ -f "$PLIST" ] || cmd_install
    launchctl bootstrap "$DOMAIN" "$PLIST"
  fi
}

cmd_stop() {
  need_job
  launchctl bootout "$DOMAIN/$LABEL"
  # bootout 发 SIGTERM；残留监听再兜底
  sleep 1
  if pid=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) && [ -n "$pid" ]; then
    echo "bootout 后 ${PORT} 仍有监听（pid ${pid}），SIGKILL 兜底"
    kill -9 "$pid" 2>/dev/null || true
  fi
  echo "已停止（真停，不会被拉回）"
}

cmd_restart() { need_job; launchctl kickstart -k "$DOMAIN/$LABEL"; echo "已重启（kickstart -k）"; }

# 改完 plist 后重载 launchd 并等服务起监听（kickstart -k 不重读 plist，必须 bootout+bootstrap）
reload_and_wait() {
  local hint="$1"
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    launchctl bootout "$DOMAIN/$LABEL"
    sleep 1
    launchctl bootstrap "$DOMAIN" "$PLIST"
  else
    echo "（LaunchAgent 未加载，下次 start 时生效）"
    return 0
  fi
  for _ in 1 2 3 4 5 6 7 8; do
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | grep -q . && break
    sleep 2
  done
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | grep -q .; then
    echo "端口 ${PORT} 已监听。${hint}URL："
    grep -oE "http://127\.0\.0\.1:${PORT}/\?token=[^ \"']+" "$LOG" 2>/dev/null | tail -1 || true
  else
    echo "端口 ${PORT} 尚未监听（${hint}冷启动可能较慢），稍后用 dsh-ctl status / url 检查" >&2
  fi
}

cmd_port() {
  if [ -z "${1:-}" ] || [ "${1#-}" != "$1" ]; then
    echo "用法: dsh-ctl port [N]   （N 为数字端口，如 3080；当前 ${PORT}）"
    return 0
  fi
  case "$1" in
    *[!0-9]*|'') echo "端口必须是数字: $1" >&2; exit 1 ;;
  esac
  if [ "$1" = "$PORT" ]; then
    echo "端口已是 $1，无需修改"
    return 0
  fi
  sed -i '' "s|<string>${PORT}</string>$|<string>$1</string>|" "$PLIST"
  plutil -lint "$PLIST" >/dev/null || { echo "plist 损坏，请手动检查 $PLIST" >&2; exit 1; }
  PORT="$1"
  echo "plist 已改为端口 $1，重启服务生效…"
  reload_and_wait ""
}

current_channel() {
  grep -oE '@deepseek-ai/dsh@[^<]+' "$PLIST" 2>/dev/null | head -1 | sed 's/.*@//' || true
}

cmd_channel() {
  local cur; cur="$(current_channel)"
  cur="${cur:-latest}"
  if [ -z "${1:-}" ] || [ "${1#-}" != "$1" ]; then
    echo "用法: dsh-ctl channel [latest|next|<版本号>]   （当前 ${cur}）"
    echo "可用通道: $(npm view @deepseek-ai/dsh dist-tags 2>/dev/null | tr -d "'" | tr -d '\n' | sed 's/ *{ *//;s/ *} *//') "
    return 0
  fi
  case "$1" in
    *[!a-zA-Z0-9._-]*) echo "通道名不合法: $1（可用: latest / next / 具体版本号）" >&2; exit 1 ;;
  esac
  if [ "$1" = "$cur" ]; then
    echo "通道已是 ${1}，无需修改"
    return 0
  fi
  # 写 plist 前校验通道/版本真实存在，防手滑写入非法值让服务崩循环
  local tags
  tags=$(npm view @deepseek-ai/dsh dist-tags --json 2>/dev/null) || tags=""
  if ! grep -q "\"$1\"" <<<"$tags"; then
    if ! npm view "@deepseek-ai/dsh@$1" version >/dev/null 2>&1; then
      echo "通道或版本不存在: $1" >&2
      echo "可用通道: $(tr -d '"' <<<"$tags" | tr -d ' \n' | sed 's/{//;s/}//')" >&2
      exit 1
    fi
  fi
  sed -i '' "s|@deepseek-ai/dsh@${cur}</string>|@deepseek-ai/dsh@${1}</string>|" "$PLIST"
  plutil -lint "$PLIST" >/dev/null || { echo "plist 损坏，请手动检查 $PLIST" >&2; exit 1; }
  echo "通道 ${cur} → ${1}，重启服务生效…（首次解析新通道要拉依赖，可能慢几十秒）"
  reload_and_wait "新通道 ${1}，"
}

cmd_install() {
  detect_pm || {
    echo "未找到 pnpm / yarn(2+) / npx 任一包管理器。先安装其一，例如:" >&2
    echo "  curl -fsSL https://get.pnpm.io/install.sh | sh -" >&2
    exit 1
  }
  echo "包管理器: ${PM_BIN} ${PM_ARGS[*]}"
  # launchd 无 shell 环境，PATH 需覆盖 node 与包管理器所在目录
  local node_dir pm_dir plist_args=""
  pm_dir="$(dirname "$PM_BIN")"
  node_dir="$(dirname "$(command -v node 2>/dev/null || echo /usr/bin/node)")"
  for a in "${PM_ARGS[@]}" "@deepseek-ai/dsh@latest" "web" "--no-open" "--port" "$PORT"; do
    plist_args+="        <string>${a}</string>
"
  done
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${PM_BIN}</string>
        ${plist_args}    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${node_dir}:${pm_dir}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>CrashOnHostWake</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>${LOG}</string>
    <key>StandardErrorPath</key>
    <string>${LOG}</string>
</dict>
</plist>
PLISTEOF
  plutil -lint "$PLIST"
  echo "已写入 $PLIST"
}

cmd_adopt() {  echo "adopt：把 3080 从宿主/其他父进程切换到 launchd。"
  echo "步骤：1) bootout（若有）2) 杀当前 3080 3) bootstrap。浏览器会话会断线，重连即可。"
  if pid=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1) && [ -n "$pid" ]; then
    ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
    pcomm=$(ps -o comm= -p "$ppid" 2>/dev/null)
    echo "当前 3080: pid=${pid} ppid=${ppid} (${pcomm})"
    if [ "$ppid" != "1" ]; then
      read -r -p "杀掉它并让 launchd 接管？[y/N] " ans
      [ "$ans" = "y" ] || { echo "放弃"; exit 0; }
    fi
  fi
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 && launchctl bootout "$DOMAIN/$LABEL" || true
  [ -f "$PLIST" ] || cmd_install
  # 杀整条进程链（dlx 的 node 父进程也要死，否则 KeepAlive 语义错乱）
  for p in $(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null); do
    pp=$(ps -o ppid= -p "$p" | tr -d ' ')
    kill "$p" 2>/dev/null || true
    [ -n "$pp" ] && [ "$pp" != "1" ] && kill "$pp" 2>/dev/null || true
  done
  sleep 1
  launchctl bootstrap "$DOMAIN" "$PLIST"
  sleep 6
  cmd_status
}

case "${1:-status}" in
  status)  cmd_status ;;
  url)     cmd_url ;;
  open)    cmd_open ;;
  log)     cmd_log ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  adopt)   cmd_adopt ;;
  install) cmd_install ;;
  port)    cmd_port "${2:-}" ;;
  channel) cmd_channel "${2:-}" ;;
  doctor)  cmd_doctor ;;
  help|-h|--help) usage 0 ;;
  *) echo "未知命令: $1" >&2; usage 1 ;;
esac
